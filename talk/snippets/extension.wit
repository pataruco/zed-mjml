world extension {
    // Zed hands these in (from the github interface):
    //   latest-github-release: func(repo: string, options: github-release-options)
    //       -> result<github-release, string>;
    import github;

    import download-file: func(url: string, file-path: string,
        file-type: downloaded-file-type) -> result<_, string>;

    import make-file-executable: func(filepath: string) -> result<_, string>;

    // The one function this extension implements:
    export language-server-command: func(language-server-id: string,
        worktree: borrow<worktree>) -> result<command, string>;
}
